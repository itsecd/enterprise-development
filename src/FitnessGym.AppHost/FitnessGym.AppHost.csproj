<Project Sdk="Aspire.AppHost.Sdk/13.5.4">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>FitnessGym-AppHost</UserSecretsId>
        <!-- Запуск через dotnet run с DCP/dashboard из NuGet, без отдельной установки Aspire CLI. -->
        <AspireUseCliBundle>false</AspireUseCliBundle>
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <!-- Исправление GHSA-qhrr-8q5h-9q3h в транзитивной зависимости Aspire 13.5. -->
        <PackageReference Include="MessagePack" Version="2.5.303" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
        <ProjectReference Include="../FitnessGym.Api/FitnessGym.Api.csproj" />
        <ProjectReference Include="../FitnessGym.MigrationService/FitnessGym.MigrationService.csproj" />
    </ItemGroup>
</Project>
