<Project Sdk="Aspire.AppHost.Sdk/13.5.4">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Dashboard и оркестратор восстанавливаются из NuGet; отдельный Aspire CLI не требуется. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>CarWash-AppHost-Lab3-64</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CarWash.Api/CarWash.Api.csproj" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>
</Project>
